// ============================================================================
// METHODOLOGY & HUNTING GOAL
// Goal: Extract ungated candidate and benign strings on {{token_field}} with fleet prevalence for length-normalized Shannon entropy scoring (WS6-03).
// Target Telemetry: UDM_EVENTS ({{event_type}})
// Statistical Model: Length-Normalized Per-Character Shannon Entropy (SHANNON_ENTROPY_CHARACTER — paired with scripts/micro_python_helpers.py shannon; stateless fallback: LONG_STRING_SCREEN)
// Mathematical Rationale:
//   - Ungated Token & Prevalence Extractor (D6 / WS6-03): Emits strings of length >= {{min_length}} across
//     both rare candidates (host_prevalence <= 2) and multi-host benign reference strings (host_prevalence >= 3)
//     together with array_distinct($entity) sample hosts.
//   - Vetted Python Helper (scripts/micro_python_helpers.py shannon): Computes exact H(s) = -Σ p(c)·log2 p(c)
//     bits/char and standardizes each rare candidate against length-matched [0.65·L, 1.5·L] benign strings.
// Sensitivity Boundary: {{tier}} (Min String Length >= {{min_length}}, Token Field = {{token_field}})
// ============================================================================

// Stage 1: Token-Level Volume, Fleet Prevalence & String Length
stage token_stats {
    metadata.event_type = "{{event_type}}"
    {{entity_field}} = $entity
    $entity != ""
    $token = {{token_field}}
    $token != ""
    {{event_filter}}

  match:
    $token

  outcome:
    $token_events = count(metadata.id)
    $host_prevalence = count_distinct($entity)
    $raw_length = max(strings.length($token))
    $distinct_procs = count_distinct(target.process.file.full_path)
}

// Root Stage: Ungated Token Cohort & Entity Attribution via array_distinct($entity)
metadata.event_type = "{{event_type}}"
{{entity_field}} = $entity
$entity != ""
$token = {{token_field}}
$token != ""
{{event_filter}}
$token = $token_stats.token

match:
  $token

outcome:
  $sample_entities = array_distinct($entity)
  $token_events = max($token_stats.token_events)
  $host_prevalence = max($token_stats.host_prevalence)
  $raw_length = max($token_stats.raw_length)

  // 6 Core Evidence Pillars
  $observation_count = max($token_stats.raw_length)
  $baseline_active_samples = max($token_stats.token_events)
  $baseline_mean = 1.0 * {{min_length}}
  $baseline_dispersion = 1.0 * max($token_stats.token_events) / max($token_stats.host_prevalence)
  $fleet_prevalence = max($token_stats.host_prevalence)
  $distinct_binaries = max($token_stats.distinct_procs)

condition:
  $raw_length >= {{min_length}}

order:
  $raw_length desc

limit:
  500
