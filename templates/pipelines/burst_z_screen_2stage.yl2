// ============================================================================
// METHODOLOGY & HUNTING GOAL
// Goal: Detect acute intraday rate bursts using Leave-One-Out Burst Z (burst Z in-query screen).
// Target Telemetry: UDM_EVENTS ({{event_type}})
// Statistical Model: Leave-One-Out Intraday Burst Z (BURST_Z_SCREEN — burst Z stateless in-query screen; true recursive lag EWMA uses EWMA_BURST_VELOCITY + scripts/micro_python_helpers.py ewma)
// Mathematical Rationale:
//   - Honest D6 G5 In-Query Screen: Stateless YARA-L buckets have no lag recursion across rows (PF-5).
//     This pipeline scores each bucket out-of-sample via Leave-One-Out Burst Z:
//     burst_z = (x_t - μ_{-t}) / max(s_{-t}, sqrt(max(μ_{-t}, 1.0))).
//   - Small-Sample & Steady-Host Protection: Enforces prior active sample floor (>= {{min_active_samples}}),
//     observation floor (>= {{min_count}}), and a continuous Poisson SD floor sqrt(max(μ_{-t}, 1.0)).
// Sensitivity Boundary: {{tier}} (Burst Z >= {{velocity_threshold}}, Min Count >= {{min_count}}, Min Prior Active Samples >= {{min_active_samples}})
// ============================================================================

// Stage 1: Bucketed Entity Activity, Squared Volume & Process Diversity
stage entity_baseline {
    metadata.event_type = "{{event_type}}"
    {{entity_field}} = $entity
    $entity != ""
    {{event_filter}}

  match:
    $entity by {{bucket_size}}

  outcome:
    $window_events = count(metadata.id)
    $window_events_sq = 1.0 * count(metadata.id) * count(metadata.id)
    $distinct_procs = count_distinct(target.process.file.full_path)
}

// Stage 2: Whole-Window Sufficient Statistics per Entity
stage entity_historical_stats {
    $entity = $entity_baseline.entity

  match:
    $entity

  outcome:
    $sum_x = sum($entity_baseline.window_events)
    $sum_x2 = sum($entity_baseline.window_events_sq)
    $active_windows = count($entity_baseline.window_start)
}

// Root Stage: Leave-One-Out Burst Z Scoring
$entity = $entity_baseline.entity
$entity = $entity_historical_stats.entity
$ws = $entity_baseline.window_start

match:
  $entity, $ws by {{bucket_size}}

outcome:
  $observation_count = max($entity_baseline.window_events)
  $baseline_active_samples = max($entity_historical_stats.active_windows) - 1
  $safe_n_prior = if($baseline_active_samples > 1, $baseline_active_samples, 1)
  $loo_sum = max($entity_historical_stats.sum_x) - $observation_count
  $baseline_mean = 1.0 * $loo_sum / $safe_n_prior
  $df = $baseline_active_samples - 1
  $safe_df = if($df > 1, $df, 1)
  $raw_ss = (max($entity_historical_stats.sum_x2) - (1.0 * $observation_count * $observation_count)) - ((1.0 * $loo_sum * $loo_sum) / $safe_n_prior)
  $pos_ss = if($raw_ss > 0.0, $raw_ss, 0.0)
  $loo_sd = math.sqrt($pos_ss / $safe_df)
  $floor_arg = if($baseline_mean > 1.0, $baseline_mean, 1.0)
  $poisson_floor = math.sqrt($floor_arg)
  $baseline_dispersion = if($loo_sd > $poisson_floor, $loo_sd, $poisson_floor)
  $burst_z = ($observation_count - $baseline_mean) / $baseline_dispersion
  $velocity_score = $burst_z
  $fleet_prevalence = 0 - 1
  $distinct_binaries = max($entity_baseline.distinct_procs)

condition:
  $baseline_active_samples >= {{min_active_samples}}
  and $observation_count >= {{min_count}}
  and $burst_z >= {{velocity_threshold}}

order:
  $burst_z desc
