// ============================================================================
// METHODOLOGY & HUNTING GOAL
// Goal: Detect scripted data exfiltration and elephant flows via Information-Theoretic Diversity Deficit and Concentration Index.
// Target Telemetry: UDM_EVENTS ({{event_type}})
// Statistical Model: Information-Theoretic Diversity Deficit & Concentration Ratio (HHI / Gini Proxy)
// Common Compiler Conformance: YARA-L 2.0 Multi-Stage DAG Engine
// Models Supported:
//   1. Information-Theoretic Diversity Deficit (Destination Breadth Z-Score & Ratio)
//   2. Concentration Index & "Elephant Flow" Isolation (Peak / Sum Bytes Proxy)
// Description:
//   Stage 1 extracts per-window event counts, destination cardinality, and peak/sum transfer bytes.
//   Stage 2 collapses per-entity historical destination breadth across all active windows.
//   The unwrapped Root stage evaluates destination diversity deficit ($diversity_z <= {{max_diversity_z}})
//   and elephant flow concentration ($concentration_ratio >= {{min_concentration_ratio}}).
// Sensitivity Boundary: {{tier}} (Diversity Z <= {{max_diversity_z}} or Concentration >= {{min_concentration_ratio}}, Min Events >= {{min_events}}, Active Samples >= {{min_active_samples}})
// ============================================================================

// Stage 1: Windowed Micro-Forensics, Volume & Destination Cardinality
stage window_metrics {
    metadata.event_type = "{{event_type}}"
    {{entity_field}} = $entity
    $entity != ""

  match:
    $entity by {{bucket_size}}

  outcome:
    $current_count = count(metadata.id)
    $distinct_targets = count_distinct(target.ip)
    $peak_bytes = max(network.sent_bytes)
    $sum_bytes = sum(network.sent_bytes)
}

// Stage 2: Unwindowed Historical Destination Breadth Baseline per Entity
stage entity_baseline {
    $entity = $window_metrics.entity

  match:
    $entity

  outcome:
    $avg_targets = avg($window_metrics.distinct_targets)
    $sd_targets = stddev($window_metrics.distinct_targets)
    $active_samples = count($window_metrics.window_start)
}

// Stage 3 (Root Stage): Common Compiler Fusion for Diversity Deficit & Concentration
$entity = $window_metrics.entity
$entity = $entity_baseline.entity
$ws = $window_metrics.window_start

match:
  $entity, $ws by {{bucket_size}}

outcome:
  // 6 Core Evidence Pillars
  $observation_count = max($window_metrics.current_count)
  $baseline_active_samples = max($entity_baseline.active_samples)
  $baseline_mean = max($entity_baseline.avg_targets)
  $baseline_dispersion = max($entity_baseline.sd_targets)
  $fleet_prevalence = 0 - 1
  $distinct_binaries = max($window_metrics.distinct_targets)

  $vocab_cardinality = max($window_metrics.distinct_targets)
  $peak_transfer = max($window_metrics.peak_bytes)
  $sum_transfers = max($window_metrics.sum_bytes)

  // Destination Diversity Deficit Z-Score
  $diff_targets = $distinct_binaries - $baseline_mean
  $raw_sd = max($entity_baseline.sd_targets)
  $safe_sd = if($raw_sd > 0, $raw_sd, 1.0)
  $diversity_z = $diff_targets / $safe_sd

  // Information-Theoretic Diversity Ratio: k / N
  $safe_count = if($observation_count > 0, $observation_count, 1)
  $diversity_ratio = $distinct_binaries / $safe_count

  // Linear Concentration Ratio: Peak / Sum (Elephant Flow Proxy)
  $safe_sum = if($sum_transfers > 0, $sum_transfers, 1.0)
  $concentration_ratio = $peak_transfer / $safe_sum

  // Combined Threat Score: Diversity deficit + concentration weight
  $z_score = 0.0 - $diversity_z
  $weight = 1.0 + $concentration_ratio
  $threat_score = ($z_score * $weight) + $concentration_ratio

condition:
  $baseline_active_samples >= {{min_active_samples}}
  and $observation_count >= {{min_events}}
  and ($diversity_z <= {{max_diversity_z}} or $concentration_ratio >= {{min_concentration_ratio}})

order:
  $threat_score desc
