// ============================================================================
// METHODOLOGY & HUNTING GOAL
// Goal: Detect dormant or quiet accounts suddenly awakening with unusual activity (Hurdle Score >= {{z_score}}).
// Target Telemetry: UDM_EVENTS ({{event_type}})
// Statistical Model: Two-Part Hurdle Outlier Model for Zero-Inflated Telemetry
// Mathematical Rationale:
//   - Part 1 (Discrete Bernoulli Hurdle): Tests whether an account was historically dormant (active_samples <= {{min_active_samples}}).
//     If dormant, sudden activity incurs a discrete activation penalty score.
//   - Part 2 (Continuous Intensity): If historically active, evaluates continuous deviation against historical baseline:
//     Z = (observed - mean) / if(safe_stddev > 0, safe_stddev, 1.0).
//   - Safe Zero-Dispersion: Divisors protected conditionally via if() without variance blunting.
// Sensitivity Boundary: {{tier}} (Hurdle Score >= {{z_score}}, Min Activity >= {{min_count}}, Min Active Samples >= {{min_active_samples}})
// ============================================================================

// Stage 1: Historical activity extraction per entity
stage entity_historical {
    metadata.event_type = "{{event_type}}"
    {{entity_field}} = $entity
    $entity != ""

  match:
    $entity by {{bucket_size}}
  outcome:
    $bucket_count = count(metadata.id)
    $distinct_targets = count_distinct(target.user.userid)
}

// Stage 2: Historical active sample density and dispersion
stage entity_stats {
    $entity = $entity_historical.entity

  match:
    $entity
  outcome:
    $hist_mean = avg($entity_historical.bucket_count)
    $hist_stddev = stddev($entity_historical.bucket_count)
    $active_samples = count($entity_historical.window_start)
}

// Stage 3: Current window activity
stage current_activity {
    metadata.event_type = "{{event_type}}"
    {{entity_field}} = $entity
    $entity != ""

  match:
    $entity by {{bucket_size}}
  outcome:
    $current_count = count(metadata.id)
    $sample_target = array_distinct(target.user.userid)
}

// Root Stage: Two-Part Hurdle Evaluation
$entity = $entity_stats.entity
$entity = $current_activity.entity
$window_start = $current_activity.window_start

match:
  $entity, $window_start by {{bucket_size}}

outcome:
  // 6 Core Evidence Pillars
  $observation_count = max($current_activity.current_count)
  $baseline_active_samples = max($entity_stats.active_samples)
  $baseline_mean = max($entity_stats.hist_mean)
  $baseline_dispersion = max($entity_stats.hist_stddev)
  $fleet_prevalence = 1
  $distinct_binaries = max($current_activity.current_count)
  $sample_commands = array_distinct($current_activity.sample_target)

  // 1. Part 1: Discrete Bernoulli Hurdle (dormant awakening)
  $is_dormant = if($baseline_active_samples <= {{min_active_samples}}, 1.0, 0.0)
  $dormant_score = $observation_count * {{dormant_weight}}

  // 2. Part 2: Continuous Intensity Conditioned on Crossing Hurdle
  $diff = $observation_count - $baseline_mean
  $safe_stddev = if($baseline_dispersion > 0, $baseline_dispersion, 1.0)
  $intensity_z = $diff / $safe_stddev

  // 3. Composite Hurdle Threat Score
  $hurdle_threat_score = if($is_dormant > 0, $dormant_score, $intensity_z)

condition:
  $observation_count >= {{min_count}}
  and $hurdle_threat_score >= {{z_score}}

order:
  $hurdle_threat_score desc
