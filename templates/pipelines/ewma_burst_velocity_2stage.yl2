// ============================================================================
// METHODOLOGY & HUNTING GOAL
// Goal: Extract ungated bucketed event series per qualifying entity for true recursive EWMA control-chart scoring (WS6-02).
// Target Telemetry: UDM_EVENTS ({{event_type}})
// Statistical Model: Exponentially Weighted Moving Average Control Chart (EWMA_BURST_VELOCITY — paired with scripts/micro_python_helpers.py ewma; stateless fallback: BURST_Z_SCREEN)
// Mathematical Rationale:
//   - Two-Stage Extractor (D6 / WS6-02): YARA-L emits compact ungated (entity, ws, window_events) rows
//     for entities meeting baseline maturity (>= {{min_active_samples}} active buckets and >= {{min_count}} total events)
//     without per-bucket Z gating, so sustained moderate +1.5σ..+2.0σ rate shifts are preserved.
//   - Vetted Python Helper (scripts/micro_python_helpers.py ewma): Zero-fills missing buckets onto the
//     dense T-bucket grid and evaluates S_t = λ·x_t + (1-λ)·S_{t-1} against UCL = μ_0 + L·σ_0·sqrt(λ/(2-λ)).
// Sensitivity Boundary: {{tier}} (Min Active Buckets >= {{min_active_samples}}, Min Total Events >= {{min_count}})
// ============================================================================

// Stage 1: Bucketed Entity Volume & Distinct Binary Diversity
stage entity_hourly {
    metadata.event_type = "{{event_type}}"
    {{entity_field}} = $entity
    $entity != ""
    {{event_filter}}

  match:
    $entity by {{bucket_size}}

  outcome:
    $window_events = count(metadata.id)
    $distinct_procs = count_distinct(target.process.file.full_path)
}

// Stage 2: Ungated Entity Maturity & Volume Prefilter
stage entity_prefilter {
    $entity = $entity_hourly.entity

  match:
    $entity

  outcome:
    $active_hours = count($entity_hourly.window_start)
    $peak_events = max($entity_hourly.window_events)
    $total_events = sum($entity_hourly.window_events)
    $hourly_mean = avg($entity_hourly.window_events)
    $hourly_sd = stddev($entity_hourly.window_events)
}

// Stage 3: Concurrent Active Fleet Breadth per Bucket
stage fleet_breadth {
    $entity = $entity_hourly.entity
    $ws = $entity_hourly.window_start

  match:
    $ws by {{bucket_size}}

  outcome:
    $active_peers = count_distinct($entity_hourly.entity)
}

// Root Stage: Ungated Bucketed Series Emission with 6 Forensic Evidence Pillars
$entity = $entity_hourly.entity
$entity = $entity_prefilter.entity
$ws = $entity_hourly.window_start
$ws = $fleet_breadth.ws

match:
  $entity, $ws by {{bucket_size}}

outcome:
  $window_events = max($entity_hourly.window_events)
  $active_hours = max($entity_prefilter.active_hours)
  $peak_events = max($entity_prefilter.peak_events)
  $total_events = max($entity_prefilter.total_events)

  // 6 Core Evidence Pillars
  $observation_count = max($entity_hourly.window_events)
  $baseline_active_samples = max($entity_prefilter.active_hours)
  $baseline_mean = max($entity_prefilter.hourly_mean)
  $baseline_dispersion = max($entity_prefilter.hourly_sd)
  $fleet_prevalence = max($fleet_breadth.active_peers)
  $distinct_binaries = max($entity_hourly.distinct_procs)

condition:
  $active_hours >= {{min_active_samples}}
  and $total_events >= {{min_count}}

order:
  $total_events desc

limit:
  1000
