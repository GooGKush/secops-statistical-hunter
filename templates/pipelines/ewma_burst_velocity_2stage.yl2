// ============================================================================
// METHODOLOGY & HUNTING GOAL
// Goal: Detect acute intraday rate acceleration using Exponentially Weighted Moving Average (EWMA) Velocity.
// Target Telemetry: UDM_EVENTS ({{event_type}})
// Statistical Model: Intraday Exponentially Weighted Moving Average (EWMA) Velocity & Rate Surge
// Mathematical Rationale:
//   - Why this model: Applies exponential weighting (S_t = α * x_t + (1 - α) * μ_hist, α = 0.3)
//     to evaluate acute rate acceleration against the entity's historical baseline trajectory,
//     isolating sudden kinetic bursts per window.
//   - Small-Sample & Multiple-Comparison Protection: Requires minimum active sample floor (>= {{min_active_samples}})
//     and minimum observation count (>= {{min_count}}) with safe dispersion floor protection.
// Sensitivity Boundary: {{tier}} (EWMA Velocity Score >= {{velocity_threshold}}, Min Count >= {{min_count}}, Min Active Samples >= {{min_active_samples}})
// ============================================================================

// Stage 1: Windowed Entity Activity & Process Diversity
stage entity_baseline {
    metadata.event_type = "{{event_type}}"
    {{entity_field}} = $entity
    $entity != ""

  match:
    $entity by {{bucket_size}}

  outcome:
    $window_events = count(metadata.id)
    $distinct_procs = count_distinct(target.process.file.full_path)
}

// Stage 2: Unwindowed Historical Baseline Statistics per Entity
stage entity_historical_stats {
    $entity = $entity_baseline.entity

  match:
    $entity

  outcome:
    $hist_mean = avg($entity_baseline.window_events)
    $hist_sd = stddev($entity_baseline.window_events)
    $active_windows = count($entity_baseline.window_start)
}

// Root Stage: EWMA Velocity Divergence & Kinetic Burst Scoring
$entity = $entity_baseline.entity
$entity = $entity_historical_stats.entity

match:
  $entity by {{bucket_size}}

outcome:
  // 6 Core Evidence Pillars
  $observation_count = max($entity_baseline.window_events)
  $baseline_active_samples = max($entity_historical_stats.active_windows)
  $baseline_mean = max($entity_historical_stats.hist_mean)
  $baseline_dispersion = max($entity_historical_stats.hist_sd)
  $fleet_prevalence = 0 - 1
  $distinct_binaries = max($entity_baseline.distinct_procs)

  // EWMA Velocity & Kinetic Burst Scoring (α = 0.3, 1 - α = 0.7)
  $observed_events = max($entity_baseline.window_events)
  $mean_events = max($entity_historical_stats.hist_mean)
  $sd_events = max($entity_historical_stats.hist_sd)
  $ewma_baseline = (0.3 * $observed_events) + (0.7 * $mean_events)
  $velocity_delta = $observed_events - $ewma_baseline
  $safe_sd = if($sd_events > 0, $sd_events, 1.0)
  $velocity_score = $velocity_delta / $safe_sd
  $ewma_velocity_score = $velocity_score

condition:
  $baseline_active_samples >= {{min_active_samples}}
  and $observation_count >= {{min_count}}
  and $velocity_score >= {{velocity_threshold}}

order:
  $velocity_score desc
