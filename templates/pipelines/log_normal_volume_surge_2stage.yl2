// ============================================================================
// METHODOLOGY & HUNTING GOAL
// Goal: Detect extreme volumetric byte surges over heavy-tailed, skewed raw network egress (Log-Normal Standardization)
// Target Telemetry: UDM_EVENTS (NETWORK_CONNECTION)
// Statistical Model: Log-Normal Parametric Z-Score (Z_log = (ln(B + 1) - μ_ln) / σ_ln)
// Mathematical Rationale:
//   - Network egress bytes follow a highly skewed, log-normal distribution across enterprise endpoints.
//   - Taking differences of raw bytes produces severe distortions and false alarms from routine high-volume transfers.
//   - Natural log transformation (math.log(sent_bytes + 1.0)) stabilizes variance, enabling standard Gaussian outlier isolation.
//   - Note: The scored window is included in the baseline estimation (in-sample baseline).
// Sensitivity Boundary: {{tier}} (Log-Z >= {{z_score}}, Min Observed Bytes >= {{min_bytes}}, Min Active Intervals >= {{min_active_samples}})
// ============================================================================

// --- STAGE 1: Period byte aggregation & log-transformation per host ---
stage host_bytes {
  metadata.event_type = "NETWORK_CONNECTION"
  {{entity_field}} = $host
  $host != ""
  network.sent_bytes > 0

match:
  $host by {{bucket_size}}

outcome:
  $total_bytes = sum(network.sent_bytes)
  $event_count = count(metadata.id)
  $log_bytes = math.log(sum(network.sent_bytes) + 1.0)
  $distinct_targets = count_distinct(target.ip)
}

// --- STAGE 2: Historical mean and standard deviation of log-transformed bytes ---
stage host_log_stats {
  $host = $host_bytes.host

match:
  $host

outcome:
  $mean_log = avg($host_bytes.log_bytes)
  $stddev_log = stddev($host_bytes.log_bytes)
  $active_samples = count($host_bytes.window_start)
}

// --- ROOT STAGE: Log-Normal Z-Score Evaluation ---
$host = $host_bytes.host
$host = $host_log_stats.host
$ws = $host_bytes.window_start

match:
  $host, $ws by {{bucket_size}}

outcome:
  // 6 Core Evidence Pillars
  $observation_count = max($host_bytes.event_count)
  $observed_bytes = max($host_bytes.total_bytes)
  $baseline_active_samples = max($host_log_stats.active_samples)
  $mean_log = max($host_log_stats.mean_log)
  $baseline_mean_log = $mean_log
  $baseline_dispersion_log = max($host_log_stats.stddev_log)
  $baseline_mean = math.pow(2.718281828, $mean_log)
  $baseline_dispersion = max($host_log_stats.stddev_log)
  $fleet_prevalence = 0 - 1
  $distinct_binaries = max($host_bytes.distinct_targets)

  // Log-Normal Z-Score derivation with safe dispersion floor
  $diff_log = max($host_bytes.log_bytes) - $mean_log
  $raw_stddev = max($host_log_stats.stddev_log)
  $safe_stddev = if($raw_stddev > 0, $raw_stddev, 1.0)
  $z_log = $diff_log / $safe_stddev

condition:
  $baseline_active_samples >= {{min_active_samples}}
  and $observed_bytes >= {{min_bytes}}
  and $z_log >= {{z_score}}

order:
  $z_log desc
