// ============================================================================
// METHODOLOGY & HUNTING GOAL
// Goal: Detect extreme volumetric byte surges over heavy-tailed, skewed raw network egress (Log-Normal Standardization)
// Target Telemetry: UDM_EVENTS (NETWORK_CONNECTION)
// Statistical Model: Leave-One-Out Log-Normal Parametric Z-Score (Z_log = (ln(B + 1) - μ_ln,{-t}) / max(s_ln,{-t}, 0.25))
// Mathematical Rationale:
//   - Network egress bytes follow a heavy-tailed, log-normal distribution across enterprise endpoints.
//   - Leave-one-out (n - 1) log-mean and sample log-SD exclude the scored bucket from its own baseline.
//   - Enforces a continuous 0.25 log-SD floor so routine <2x byte fluctuations do not trigger false alarms,
//     and emits all 6 Evidence Pillars in consistent byte units.
// Sensitivity Boundary: {{tier}} (Log-Z >= {{z_score}}, Min Observed Bytes >= {{min_bytes}}, Min Prior Active Intervals >= {{min_active_samples}})
// ============================================================================

// --- STAGE 1: Bucketed byte aggregation & log-transformation per entity ---
stage host_bytes {
  metadata.event_type = "NETWORK_CONNECTION"
  {{entity_field}} = $host
  $host != ""
  network.sent_bytes > 0
  {{event_filter}}

match:
  $host by {{bucket_size}}

outcome:
  $total_bytes = sum(network.sent_bytes)
  $event_count = count(metadata.id)
  $log_bytes = math.log(sum(network.sent_bytes) + 1.0)
  $log_bytes_sq = math.log(sum(network.sent_bytes) + 1.0) * math.log(sum(network.sent_bytes) + 1.0)
  $distinct_targets = count_distinct(target.ip)
}

// --- STAGE 2: Whole-window sufficient statistics of log-transformed bytes ---
stage host_log_stats {
  $host = $host_bytes.host

match:
  $host

outcome:
  $sum_log = sum($host_bytes.log_bytes)
  $sum_log2 = sum($host_bytes.log_bytes_sq)
  $active_samples = count($host_bytes.window_start)
}

// --- ROOT STAGE: Leave-One-Out Log-Normal Z-Score & Byte-Consistent Evidence Pillars ---
$host = $host_bytes.host
$host = $host_log_stats.host
$ws = $host_bytes.window_start

match:
  $host, $ws by {{bucket_size}}

outcome:
  $observed_bytes = max($host_bytes.total_bytes)
  $obs_log = max($host_bytes.log_bytes)
  $baseline_active_samples = max($host_log_stats.active_samples) - 1
  $safe_n_prior = if($baseline_active_samples > 1, $baseline_active_samples, 1)
  $loo_sum_log = max($host_log_stats.sum_log) - $obs_log
  $baseline_mean_log = 1.0 * $loo_sum_log / $safe_n_prior
  $df = $baseline_active_samples - 1
  $safe_df = if($df > 1, $df, 1)
  $raw_ss_log = (max($host_log_stats.sum_log2) - ($obs_log * $obs_log)) - (($loo_sum_log * $loo_sum_log) / $safe_n_prior)
  $pos_ss_log = if($raw_ss_log > 0.0, $raw_ss_log, 0.0)
  $loo_sd_log = math.sqrt($pos_ss_log / $safe_df)
  $baseline_dispersion_log = if($loo_sd_log > 0.25, $loo_sd_log, 0.25)
  $z_log = ($obs_log - $baseline_mean_log) / $baseline_dispersion_log

  // 6 Core Evidence Pillars (all volumetric quantities in consistent byte units)
  $observation_count = $observed_bytes
  $baseline_mean = math.pow(2.718281828, $baseline_mean_log)
  $baseline_dispersion = math.pow(2.718281828, $baseline_mean_log + $baseline_dispersion_log) - $baseline_mean
  $fleet_prevalence = 0 - 1
  $distinct_binaries = max($host_bytes.distinct_targets)
  $event_count = max($host_bytes.event_count)

condition:
  $baseline_active_samples >= {{min_active_samples}}
  and $observed_bytes >= {{min_bytes}}
  and $z_log >= {{z_score}}

order:
  $z_log desc
