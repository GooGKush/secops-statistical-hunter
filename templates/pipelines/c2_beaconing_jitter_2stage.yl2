// ============================================================================
// METHODOLOGY & HUNTING GOAL
// Goal: Extract hourly array_distinct(event_timestamp.seconds) per persistent low-prevalence external pair for exact C2 inter-arrival jitter scoring (WS6-04).
// Target Telemetry: UDM_EVENTS ({{event_type}})
// Statistical Model: Consecutive Inter-Arrival Jitter & Periodicity (C2_BEACONING_JITTER — paired with scripts/micro_python_helpers.py c2-jitter; stateless fallback: FLOW_GAP_RATIO_SCREEN)
// Mathematical Rationale:
//   - Two-Stage Candidate Pair + Hourly Timestamp Array Extractor (D6 / WS6-04): Filters non-RFC1918,
//     non-loopback, non-multicast, non-broadcast, non-link-local external pairs with persistence
//     (>= {{min_active_hours}} active hours), bounded volume ({{min_conns}}..{{max_conns}}), and low fleet prevalence (<= {{prevalence}}).
//   - Hourly Bucketed array_distinct($ts): Emits up to 25 distinct timestamps per (src_ip, dst_ip, ws) hour
//     (up to 600 timestamps across 24h) so scripts/micro_python_helpers.py c2-jitter computes sorted Δt_i, CV, and periodicity.
// Sensitivity Boundary: {{tier}} (Target CV <= {{cv}}, Conns {{min_conns}}..{{max_conns}}, Prevalence <= {{prevalence}}, Active Hours >= {{min_active_hours}})
// ============================================================================

// Stage 1: Hourly External Connection Persistence per (src_ip, dst_ip) Pair
stage host_intervals {
    metadata.event_type = "{{event_type}}"
    target.ip = $dst_ip
    $dst_ip != ""
    $dst_ip != "::1"
    {{entity_field}} = $src_ip
    $src_ip != ""
    {{event_filter}}
    // Exclude internal RFC 1918, loopback, multicast, broadcast, and IPv4/IPv6 link-local destinations
    not net.ip_in_range_cidr($dst_ip, "10.0.0.0/8")
    not net.ip_in_range_cidr($dst_ip, "172.16.0.0/12")
    not net.ip_in_range_cidr($dst_ip, "192.168.0.0/16")
    not net.ip_in_range_cidr($dst_ip, "127.0.0.0/8")
    not net.ip_in_range_cidr($dst_ip, "224.0.0.0/4")
    not net.ip_in_range_cidr($dst_ip, "169.254.0.0/16")
    not net.ip_in_range_cidr($dst_ip, "255.255.255.255/32")
    not net.ip_in_range_cidr($dst_ip, "fe80::/10")
    not net.ip_in_range_cidr($dst_ip, "ff00::/8")

  match:
    $src_ip, $dst_ip by {{bucket_size}}

  outcome:
    $conn_count = count(metadata.id)
    $distinct_procs = count_distinct(principal.process.file.full_path)
}

// Stage 2: Whole-Window Persistence & Volume Prefilter per Pair
stage pair_persistence {
    $src_ip = $host_intervals.src_ip
    $dst_ip = $host_intervals.dst_ip

  match:
    $src_ip, $dst_ip

  outcome:
    $total_conns = sum($host_intervals.conn_count)
    $active_hours = count($host_intervals.window_start)
    $hourly_mean = avg($host_intervals.conn_count)
    $hourly_sd = stddev($host_intervals.conn_count)
    $pair_procs = max($host_intervals.distinct_procs)
}

// Stage 3: Enterprise Destination Prevalence
stage dst_prevalence {
    $dst_ip = $host_intervals.dst_ip

  match:
    $dst_ip

  outcome:
    $src_breadth = count_distinct($host_intervals.src_ip)
}

// Root Stage: Hourly Timestamp Array Collection per Qualifying Pair with 6 Forensic Evidence Pillars
metadata.event_type = "{{event_type}}"
target.ip = $dst_ip
$dst_ip != ""
$dst_ip != "::1"
{{entity_field}} = $src_ip
$src_ip != ""
{{event_filter}}
not net.ip_in_range_cidr($dst_ip, "10.0.0.0/8")
not net.ip_in_range_cidr($dst_ip, "172.16.0.0/12")
not net.ip_in_range_cidr($dst_ip, "192.168.0.0/16")
not net.ip_in_range_cidr($dst_ip, "127.0.0.0/8")
not net.ip_in_range_cidr($dst_ip, "224.0.0.0/4")
not net.ip_in_range_cidr($dst_ip, "169.254.0.0/16")
not net.ip_in_range_cidr($dst_ip, "255.255.255.255/32")
not net.ip_in_range_cidr($dst_ip, "fe80::/10")
not net.ip_in_range_cidr($dst_ip, "ff00::/8")
$ts = metadata.event_timestamp.seconds
$ws = timestamp.get_timestamp(metadata.event_timestamp.seconds, "HOUR", "UTC")
$src_ip = $pair_persistence.src_ip
$dst_ip = $pair_persistence.dst_ip
$dst_ip = $dst_prevalence.dst_ip

match:
  $src_ip, $dst_ip, $ws

outcome:
  $event_timestamps = array_distinct($ts)
  $bucket_conns = count(metadata.id)
  $total_conns = max($pair_persistence.total_conns)
  $active_hours = max($pair_persistence.active_hours)

  // 6 Core Evidence Pillars
  $observation_count = max($pair_persistence.total_conns)
  $baseline_active_samples = max($pair_persistence.active_hours)
  $baseline_mean = max($pair_persistence.hourly_mean)
  $baseline_dispersion = max($pair_persistence.hourly_sd)
  $fleet_prevalence = max($dst_prevalence.src_breadth)
  $distinct_binaries = max($pair_persistence.pair_procs)

condition:
  $active_hours >= {{min_active_hours}}
  and $total_conns >= {{min_conns}}
  and $total_conns <= {{max_conns}}
  and $fleet_prevalence <= {{prevalence}}

order:
  $total_conns desc

limit:
  1000
