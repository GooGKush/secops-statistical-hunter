// ============================================================================
// METHODOLOGY & HUNTING GOAL
// Goal: Detect Producer-Consumer Byte Ratio Inversion (Endpoint Shifting from Net Consumer to Data Producer).
// Target Telemetry: UDM_EVENTS ({{event_type}})
// Statistical Model: Leave-One-Out Directional Producer Ratio Standardization (Z_rho = (rho_obs - mu_rho_LOO) / max(sd_rho_LOO, 0.05))
// Mathematical Rationale:
//   - Standard workstations and application clients maintain a low historical producer ratio rho = sent / (sent + recv + 1),
//     whereas dedicated log forwarders and backup agents maintain a consistently high historical rho (~0.90).
//   - Standardizing the current window's producer ratio $producer_ratio against the entity's leave-one-out historical
//     producer-ratio mean and dispersion (floored continuously at 0.05) suppresses steady high-ratio forwarders while
//     isolating true role inversions on consumer endpoints.
// Sensitivity Boundary: {{tier}} (Producer Ratio >= {{min_producer_ratio}}, Ratio Inversion Z >= {{z_score}}σ, Sent Bytes >= {{min_sent_bytes}}, Active Samples >= {{min_active_samples}})
// ============================================================================

// Stage 1: Aggregate per-window directional bytes, producer ratio moments, and destination diversity
stage stage1_directional_bytes {
    metadata.event_type = "{{event_type}}"
    {{entity_field}} = $entity
    $entity != ""
    target.ip = $dst_ip
    $dst_ip != ""

  match:
    $entity by {{bucket_size}}

  outcome:
    $event_count = count(metadata.id)
    $sent_bytes = sum(network.sent_bytes)
    $recv_bytes = sum(network.received_bytes)
    $bucket_ratio = 1.0 * sum(network.sent_bytes) / (sum(network.sent_bytes) + sum(network.received_bytes) + 1.0)
    $bucket_ratio_sq = (1.0 * sum(network.sent_bytes) / (sum(network.sent_bytes) + sum(network.received_bytes) + 1.0)) * (1.0 * sum(network.sent_bytes) / (sum(network.sent_bytes) + sum(network.received_bytes) + 1.0))
    $distinct_targets = count_distinct($dst_ip)
}

// Stage 2: Accumulate per-entity historical producer ratio moments across active windows
stage stage2_entity_baseline {
    $entity = $stage1_directional_bytes.entity

  match:
    $entity

  outcome:
    $active_windows = count($stage1_directional_bytes.window_start)
    $sum_ratio = sum($stage1_directional_bytes.bucket_ratio)
    $sum_ratio_sq = sum($stage1_directional_bytes.bucket_ratio_sq)
}

// Root Stage: Score Leave-One-Out Producer Ratio Inversion Z-Score & 6 Evidence Pillars
$entity = $stage1_directional_bytes.entity
$entity = $stage2_entity_baseline.entity
$ws = $stage1_directional_bytes.window_start

match:
  $entity, $ws by {{bucket_size}}

outcome:
  // 6 Core Evidence Pillars & Leave-One-Out Ratio Baseline
  $observation_count = max($stage1_directional_bytes.sent_bytes)
  $baseline_active_samples = max($stage2_entity_baseline.active_windows)
  $fleet_prevalence = 0 - 1
  $distinct_binaries = max($stage1_directional_bytes.distinct_targets)
  $producer_ratio = max($stage1_directional_bytes.bucket_ratio)

  $raw_n_prior = $baseline_active_samples - 1
  $n_prior = if($raw_n_prior > 1, $raw_n_prior, 1)
  $raw_loo_sum = max($stage2_entity_baseline.sum_ratio) - $producer_ratio
  $loo_sum = if($raw_loo_sum > 0.0, $raw_loo_sum, 0.0)
  $baseline_mean = $loo_sum / $n_prior
  $raw_loo_var = ((max($stage2_entity_baseline.sum_ratio_sq) - ($producer_ratio * $producer_ratio)) / $n_prior) - ($baseline_mean * $baseline_mean)
  $safe_var = if($raw_loo_var > 0.0025, $raw_loo_var, 0.0025)
  $baseline_dispersion = math.sqrt($safe_var)
  $z_score = ($producer_ratio - $baseline_mean) / $baseline_dispersion

condition:
  $baseline_active_samples >= {{min_active_samples}}
  and $observation_count >= {{min_sent_bytes}}
  and $producer_ratio >= {{min_producer_ratio}}
  and $z_score >= {{z_score}}

order:
  $z_score desc
